{
  "name": "lectpy-shell",
  "private": true,
  "version": "0.2.0",
  "description": "lectpy browser shell — lecture replay over the versioned event protocol",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sample": "node scripts/copy-sample.mjs && vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@xterm/xterm": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "~5.6.0",
    "vite": "^6.3.0",
    "vitest": "^3.0.0"
  }
}
